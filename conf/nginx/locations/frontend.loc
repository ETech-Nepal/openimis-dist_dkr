

    location / {
            # explicit ${HTTPS_PORT} so this redirects correctly to the HTTPS
            # port from both HTTP and HTTPS entry, even when HTTPS_PORT is
            # remapped away from 443 (see compose.base.yml)
            return 302 https://$host:${HTTPS_PORT}/${PUBLIC_URL}/;
        }

    location /${PUBLIC_URL} {
        try_files $uri $uri/  /${PUBLIC_URL}/index.html;
        #error_page 404 $scheme://$host/front/;
    }
